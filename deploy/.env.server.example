# Copy to .env next to compose.yaml, edit the CHANGE lines, then: chmod 600 .env

# First administrator, used once when the database is created.
# Remove the password after the first start.
MINERVA_ADMIN_EMAIL=admin@notes.example.com            # CHANGE
MINERVA_ADMIN_PASSWORD=change-me-12-characters-or-more  # CHANGE

# The address people open, without a trailing slash.
MINERVA_PUBLIC_URL=https://notes.example.com           # CHANGE
# 1 behind HTTPS (production); 0 only for a plain-HTTP trial.
MINERVA_SECURE_COOKIE=1

MINERVA_SITE_NAME=Published notes
MINERVA_TOTP_ISSUER=Minerva
