# Minerva production settings, read by `docker compose` from a file named .env
# next to docker-compose.yml:
#
#   cp .env.example .env     # then edit every value marked CHANGE
#   docker compose up -d --build
#
# Never commit .env: it holds the administrator password and the tunnel token.
# An empty value means "not set" (the built-in default applies).

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# How Minerva is reached from the internet, so plain `docker compose up -d`
# starts the right services:
#   https   Caddy with automatic Let's Encrypt certificates (ports 80 and 443)
#   tunnel  Cloudflare Tunnel (no open ports; set CLOUDFLARE_TUNNEL_TOKEN)
#   (empty) Minerva only, on 127.0.0.1:MINERVA_PORT, for your own reverse proxy
COMPOSE_PROFILES=https

# Port on this host for Minerva itself. It is bound to 127.0.0.1 only.
MINERVA_PORT=3000

# ---------------------------------------------------------------------------
# First administrator (used once, when the database is created)
# ---------------------------------------------------------------------------

# CHANGE: your email address; it is the administrator's sign-in.
MINERVA_ADMIN_EMAIL=admin@notes.example.com
# CHANGE: 12 to 256 characters. Remove it from .env after the first start; it
# is never read again, and changing it later does not change the password.
MINERVA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------

# CHANGE: the address users open, with https:// and without a trailing slash.
# Used for MCP origin checks, published-page feed links, and share links.
MINERVA_PUBLIC_URL=https://notes.example.com
# 1 when users reach Minerva over HTTPS (always in production): session cookies
# are then sent over HTTPS only. 0 only for a local HTTP trial.
MINERVA_SECURE_COOKIE=1

# CHANGE (https profile): the domain Caddy requests a certificate for. Its DNS
# must point to this host, with ports 80 and 443 open.
MINERVA_DOMAIN=notes.example.com

# CHANGE (tunnel profile): the token of a Cloudflare Tunnel (Zero Trust →
# Networks → Tunnels). Give the tunnel a public hostname with service
# http://minerva:3000. Only the cloudflared container receives it.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Published pages and sign-in
# ---------------------------------------------------------------------------

# Title of the published-pages index (/p/) and its Atom feed.
MINERVA_SITE_NAME=Published notes
# Public theme for pages that are not part of a site: paper, midnight,
# sunrise, terminal, or the name of your own in plugins/public-notes-themes.
# Empty uses the default look.
MINERVA_PUBLIC_THEME=
# Name shown in authenticator apps for two-factor sign-in.
MINERVA_TOTP_ISSUER=Minerva

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Other Minerva apps allowed to show this server's notes in their tabs: exact
# origins, comma-separated, e.g. https://notes.other.example. Empty allows none.
MINERVA_EMBED_ORIGINS=

# Learning plugin transcription (needs the optional media image; see
# plugins/server/superhuman-learning/README.md): the ID of an AI provider
# profile, a model that returns timestamped segments, and the Python to run.
MINERVA_ASR_PROVIDER=
MINERVA_ASR_MODEL=
MINERVA_PLUGIN_PYTHON=

# ---------------------------------------------------------------------------
# Set by the image; not read from this file
# ---------------------------------------------------------------------------
# MINERVA_DATABASE=/data/minerva.db   database (with minerva.db.ai-key) in the
#                                     minerva-data volume; back up both together
# MINERVA_BIND=0.0.0.0:3000           listen address inside the container
# MINERVA_PLUGINS=/plugins            ./plugins, mounted read-only
